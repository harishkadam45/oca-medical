---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import LocationsMap from '../components/LocationsMap.astro';
import Header from '../components/Header';
import AppointmentForm from '../components/AppointmentForm';
import TestimonialCarousel from '../components/TestimonialCarousel';
import { images, insurers, stats } from '../data/site';
---

<Layout>
  <Header client:load />

  <main>
    <!-- Hero -->
    <section class="relative isolate overflow-hidden bg-sky text-center">
      {images.hero && <img src={images.hero} alt="" class="absolute inset-0 -z-20 h-full w-full object-cover" />}
      <div class="absolute inset-0 -z-10 bg-linear-to-br from-sky/90 via-sky/80 to-cyan/70"></div>
      <div class="container-page py-16 sm:py-24">
        <h1 class="text-2xl font-bold leading-snug text-navy sm:text-4xl sm:leading-snug">
          Pain Experts So Good,<br />
          We Don’t Want You Coming Back…<br />
          We Want You Cured!
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-sm font-medium text-white sm:text-lg">
          We identify and fix the biomechanical cause of your pain—so you can move on with your life
        </p>
        <a href="#book" class="btn-cyan mt-7 italic">Book a Free Consultation</a>
      </div>
    </section>

    <!-- Stats -->
    <section class="bg-navy text-white" aria-label="Practice statistics">
      <dl class="container-page grid grid-cols-3 gap-4 py-8 text-center sm:py-10">
        {
          stats.map((s) => (
            <div class="flex flex-col-reverse gap-2">
              <dt class="text-[0.6rem] font-medium uppercase tracking-widest text-white/80 sm:text-xs">{s.label}</dt>
              <dd class="text-xl font-light text-cyan sm:text-4xl">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Levels of care -->
    <section id="care" class="py-12 sm:py-16">
      <div class="container-page">
        <h2 class="text-center text-2xl font-bold sm:text-3xl">When You Need the Next Level of Care</h2>
        <p class="mx-auto mt-5 max-w-3xl text-center text-sm leading-relaxed sm:text-base">
          Our team of physicians, chiropractors, physical therapists, and massage therapists use coordinated techniques
          to solve the biomechanical cause of your pain at the source in ways others can’t…all under one roof.
        </p>

        <div class="mt-10 grid md:grid-cols-2">
          <article class="bg-cyan p-7 sm:p-10">
            <h3 class="text-center text-2xl font-bold sm:text-3xl">Interventional Care</h3>
            <svg viewBox="0 0 48 64" class="mx-auto my-5 h-16 w-12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="15" y="4" width="18" height="10" rx="3"></rect>
              <rect x="13" y="19" width="22" height="10" rx="3"></rect>
              <rect x="13" y="34" width="22" height="10" rx="3"></rect>
              <rect x="15" y="49" width="18" height="10" rx="3"></rect>
              <path d="M15 9H6M33 9h9M13 24H4M35 24h9M13 39H4M35 39h9M15 54H6M33 54h9"></path>
            </svg>
            <p class="text-sm leading-relaxed sm:text-base">
              Minimally invasive medical procedures designed to directly address the underlying cause of pain rather
              than just managing symptoms. These options are often used when conservative care alone is not sufficient.
            </p>
          </article>

          <article class="bg-sky p-7 sm:p-10">
            <h3 class="text-center text-2xl font-bold sm:text-3xl">Orthopedic Care</h3>
            <svg viewBox="0 0 64 64" class="mx-auto my-5 h-16 w-16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 35 35 22a7 7 0 1 1 11-7 7 7 0 1 1-4 11L29 42a7 7 0 1 1-11 7 7 7 0 1 1 4-14z"></path>
            </svg>
            <p class="text-sm leading-relaxed sm:text-base">
              Treatment of structural musculoskeletal conditions, often when conservative and interventional options
              are no longer effective. This level of care may involve surgical procedures relieve nerve pressure and
              treat pain sources.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- Options / coverage -->
    <section id="coverage" class="pb-12 sm:pb-16">
      <div class="container-page grid gap-6 md:grid-cols-2">
        <article class="flex flex-col items-center rounded-[2rem] bg-mist p-7 text-center sm:p-9">
          <h2 class="text-xl font-extrabold uppercase sm:text-2xl">
            Know All Your Options
            <span class="block text-base sm:text-lg">(Before Drugs or Surgery)</span>
          </h2>
          <p class="mt-2 text-sm">First, we will run a full diagnostic test to address pain at the source.</p>
          <div class="relative mt-4 aspect-video w-full max-w-64 overflow-hidden rounded-md">
            <Photo src={images.newPatient} alt="New patient experience video preview" label="" />
            <p class="absolute inset-0 grid place-items-center bg-navy/30 px-4 text-xs font-bold uppercase leading-tight text-white">
              New patient experience: what to expect.
            </p>
          </div>
          <a href="#book" class="btn-cyan mt-6 rounded-full px-8 italic md:mt-auto md:translate-y-2">Book a Consultation</a>
        </article>

        <article class="flex flex-col items-center rounded-[2rem] bg-mist p-7 text-center sm:p-9">
          <h2 class="text-xl font-extrabold uppercase sm:text-2xl">
            Know Your Coverage
            <span class="block text-base sm:text-lg">(You May Be Covered)</span>
          </h2>
          <p class="mt-2 text-sm">Proud providers of major insurance companies</p>
          <ul class="mt-4 grid w-full max-w-sm grid-cols-2 gap-2 sm:grid-cols-4">
            {
              insurers.map((name) => (
                <li class="grid min-h-12 place-items-center rounded-md bg-white px-2 py-2 text-[0.65rem] font-bold leading-tight text-navy shadow-sm">
                  {name}
                </li>
              ))
            }
          </ul>
          <a href="#verify" class="btn-cyan mt-6 rounded-full px-8 italic md:mt-auto md:translate-y-2">Verify My Insurance</a>
        </article>
      </div>
    </section>

    <!-- Verify insurance -->
    <section id="verify">
      <div class="container-page">
        <div class="grid bg-neutral-300 md:grid-cols-2">
          <div class="flex flex-col justify-center px-6 py-10 sm:px-10 md:items-start">
            <h2 class="text-2xl font-extrabold uppercase italic sm:text-3xl">Verify Your Insurance</h2>
            <p class="mt-5 max-w-sm text-sm leading-relaxed sm:text-base">
              Fill out form and we’ll get back to you to inform you of what exactly is included in your insurance
              coverage from injections to surgeries.
            </p>
            <a href="#book" class="btn-cyan mt-6 self-start px-10">Claim Offer</a>
          </div>
          <div class="h-56 md:h-auto md:min-h-72">
            <Photo src={images.verify} alt="Doctor reviewing an X-ray" label="Photo: doctor reviewing X-ray" />
          </div>
        </div>
      </div>
    </section>

    <!-- Welcome -->
    <section id="about" class="py-12 sm:py-16">
      <div class="container-page grid items-center gap-8 md:grid-cols-[2fr_3fr]">
        <div class="aspect-square overflow-hidden rounded-3xl">
          <Photo src={images.building} alt="OCA Medical Group clinic building" label="Photo: clinic building" />
        </div>
        <div>
          <h2 class="text-3xl font-extrabold leading-tight sm:text-4xl">
            Welcome to the<br />OCA Medical Group
          </h2>
          <p class="mt-5 text-sm leading-relaxed">
            Goodlife Physical Medicine delivers integrated, patient-focused care through a team of specialists in
            chiropractic, pain management, physical medicine, and conventional medicine. Using an integrative approach,
            the team combines traditional medical care with complementary therapies to create customized treatment
            plans.
          </p>
          <p class="mt-4 text-sm leading-relaxed">
            As a multidisciplinary one-stop clinic, Goodlife offers on-site diagnostic imaging, including digital
            X-rays, ultrasound, and MRI, allowing for fast and accurate diagnoses. The focus is on long-term relief and
            overall wellness without relying on addictive medications, unnecessary surgery, or invasive procedures.
          </p>
          <a href="#care" class="btn-cyan mt-6 rounded-none px-10 py-3 text-sm">Read More About Us</a>
        </div>
      </div>
    </section>

    <!-- Booking -->
    <section id="book" class="bg-navy py-10 sm:py-12">
      <div class="container-page grid gap-6 md:grid-cols-[2fr_3fr]">
        <AppointmentForm client:visible />
        <LocationsMap />
      </div>
    </section>

    <!-- Testimonials -->
    <section id="testimonials" class="py-12 sm:py-16">
      <div class="container-page">
        <h2 class="mb-8 text-center text-2xl font-extrabold uppercase sm:text-3xl">
          How We’ve Helped Others the OCA Way
        </h2>
        <TestimonialCarousel client:visible />
      </div>
    </section>
  </main>

  <footer class="bg-black py-14 text-center text-white">
    <div class="container-page">
      <p class="text-sm font-bold uppercase tracking-wide">OCA Medical Group</p>
      <p class="mt-2 text-xs text-white/60">© {new Date().getFullYear()} OCA Medical Group. All rights reserved.</p>
    </div>
  </footer>
</Layout>
