---
import { locations } from '../data/site';
---

<div
  class="relative h-full min-h-72 overflow-hidden rounded-3xl border-2 border-pin/60 bg-neutral-200"
  role="img"
  aria-label={`Map of our locations: ${locations.map((l) => l.name).join(', ')}`}
>
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full" aria-hidden="true">
    <rect width="400" height="300" fill="#dcdcdc"></rect>
    <!-- ocean -->
    <path d="M0 0h60c-6 40 4 70 22 104 16 30 40 46 58 78 20 34 70 44 120 58 40 11 90 30 140 34v26H0z" fill="#f4f4f4"></path>
    <!-- roads -->
    <g fill="none" stroke="#f7f7f7" stroke-width="2.5" stroke-linecap="round">
      <path d="M70 0c10 60 40 110 90 150s150 70 240 80"></path>
      <path d="M150 0c0 70 20 130 80 180s110 60 170 70"></path>
      <path d="M60 60c80 10 200 0 340 20"></path>
      <path d="M100 130c90-10 190 0 300 30"></path>
      <path d="M250 0c-10 80 10 160 60 230"></path>
      <path d="M330 0c0 70 10 140 40 220"></path>
    </g>
  </svg>

  {
    locations.map((loc) => (
      <div class="absolute -translate-x-1/2 -translate-y-full" style={`left:${loc.x}%;top:${loc.y}%`}>
        <svg viewBox="0 0 24 24" class="mx-auto h-5 w-5 text-pin" fill="currentColor" aria-hidden="true">
          <path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
        </svg>
        <span class="mt-0.5 block whitespace-nowrap rounded bg-pin px-2 py-0.5 text-[0.6rem] font-bold uppercase tracking-wide text-white">
          {loc.name}
        </span>
      </div>
    ))
  }
</div>
